generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ApiKey {
  id        String    @id @default(uuid())
  name      String
  prefix    String
  hash      String    @unique
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([prefix])
  @@map("api_keys")
}

model Camera {
  id            String   @id @default(uuid())
  cameraId      String   @unique @map("camera_code")
  name          String
  cameraIp      String   @unique @map("camera_ip")
  port          Int      @default(80)
  protocol      String   @default("http")
  username      String?
  password      String?
  clip          Int      @default(0)
  volume        Int      @default(100)
  repeat        Int      @default(0)
  audiodeviceid Int      @default(0) @map("audio_device_id")
  audiooutputid Int      @default(0) @map("audio_output_id")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("cameras")
}

model AuditLog {
  id              String   @id @default(uuid())
  action          String
  cameraId        String   @map("camera_id")
  requestPayload  Json     @map("request_payload")
  responsePayload Json?    @map("response_payload")
  status          String
  errorMessage    String?  @map("error_message")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([action])
  @@index([cameraId])
  @@index([createdAt])
  @@map("audit_logs")
}
